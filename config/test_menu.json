{
  "namespace": "guigen",
  "menu_id": "test_menu",
  "display_name": "GUI-GENERATOR (widgets + containers)",
  "pack_description": "GUI-GENERATOR – demo menu (JSON config)",
  "timer_ticks": 900,
  "follow": true,
  "distance_close": 32,
  "container": {
    "type": "chest_minecart",
    "invulnerable": true,
    "no_gravity": true,
    "silent": true
  },
  "extra_scores": [
    "guigen_level"
  ],
  "opener_name": "GUI Menu Key",
  "opener_lore": "Run /function guigen:menu/test_menu/open",
  "pages": [
    {
      "index": 0,
      "name": "Main",
      "widgets": [
        {
          "kind": "label",
          "slot": 1,
          "item": "minecraft:name_tag",
          "name": {
            "text": "— Main Menu —",
            "color": "gold",
            "bold": true
          },
          "lore": [
            {
              "text": "GUI-GENERATOR demo (JSON)",
              "color": "gray"
            }
          ]
        },
        {
          "kind": "confirm",
          "slot": 0,
          "item": "minecraft:compass",
          "action_id": "goto_confirm_tp",
          "name": {
            "text": "Teleport to Spawn",
            "color": "aqua"
          },
          "lore": [
            {
              "text": "Opens confirmation page",
              "color": "gray"
            }
          ],
          "confirm_page": 2,
          "sound": "minecraft:ui.button.click"
        },
        {
          "kind": "button",
          "slot": 2,
          "item": "minecraft:golden_apple",
          "action_id": "heal",
          "name": {
            "text": "Heal & Feed",
            "color": "green"
          },
          "lore": [
            {
              "text": "Fully restore health and hunger",
              "color": "gray"
            }
          ],
          "commands": [
            "effect give @s minecraft:instant_health 1 10 true",
            "effect give @s minecraft:saturation 1 10 true"
          ],
          "sound": "minecraft:entity.player.levelup",
          "success_message": {
            "text": "Fully healed and fed.",
            "color": "green"
          },
          "cooldown_ticks": 40
        },
        {
          "kind": "button",
          "slot": 4,
          "item": "minecraft:nether_star",
          "action_id": "give_diamond",
          "name": {
            "text": "Give Diamond",
            "color": "light_purple"
          },
          "lore": [
            {
              "text": "Only if you have < 5 diamonds",
              "color": "gray"
            }
          ],
          "condition": {
            "type": "item_count_lt",
            "item": "minecraft:diamond",
            "max_count": 5,
            "fail_message": {
              "text": "Denied: you already have 5+ diamonds.",
              "color": "red"
            }
          },
          "commands": [
            "give @s minecraft:diamond 1"
          ],
          "sound": "minecraft:entity.experience_orb.pickup",
          "success_message": {
            "text": "You received a diamond.",
            "color": "light_purple"
          },
          "cost": {
            "item": "minecraft:coal",
            "count": 3,
            "fail_message": {
              "text": "Need 3 coal to buy a diamond.",
              "color": "red"
            }
          }
        },
        {
          "kind": "separator",
          "slot": 3
        },
        {
          "kind": "separator",
          "slot": 5
        },
        {
          "kind": "nav",
          "slot": 6,
          "item": "minecraft:arrow",
          "action_id": "page_next",
          "name": {
            "text": "Next Page →",
            "color": "yellow"
          },
          "lore": [
            {
              "text": "Tools, toggles, counters",
              "color": "gray"
            }
          ],
          "target_page": 1,
          "sound": "minecraft:ui.button.click",
          "success_message": {
            "text": "Page 1 – Tools",
            "color": "yellow"
          }
        },
        {
          "kind": "close",
          "slot": 8,
          "item": "minecraft:barrier",
          "sound": "minecraft:ui.button.click"
        }
      ]
    },
    {
      "index": 1,
      "name": "Tools",
      "widgets": [
        {
          "kind": "label",
          "slot": 1,
          "item": "minecraft:name_tag",
          "name": {
            "text": "— Tools & State —",
            "color": "gold",
            "bold": true
          }
        },
        {
          "kind": "toggle",
          "slot": 0,
          "action_id": "toggle_nv",
          "sound": "minecraft:ui.button.click",
          "toggle": {
            "score": "guigen_toggle_nv",
            "off_item": "minecraft:gray_dye",
            "on_item": "minecraft:lime_dye",
            "off_name": {
              "text": "Night Vision: OFF",
              "color": "dark_gray"
            },
            "on_name": {
              "text": "Night Vision: ON",
              "color": "green"
            },
            "off_lore": [
              {
                "text": "Shift-click to enable",
                "color": "gray"
              }
            ],
            "on_lore": [
              {
                "text": "Shift-click to disable",
                "color": "gray"
              }
            ],
            "on_commands": [
              "effect give @s minecraft:night_vision infinite 0 true"
            ],
            "off_commands": [
              "effect clear @s minecraft:night_vision"
            ],
            "tick_while_on": [
              "effect give @s minecraft:night_vision infinite 0 true"
            ]
          }
        },
        {
          "kind": "button",
          "slot": 2,
          "item": "minecraft:sunflower",
          "action_id": "set_day",
          "name": {
            "text": "Set Day",
            "color": "gold"
          },
          "commands": [
            "time set day"
          ],
          "sound": "minecraft:ui.button.click",
          "success_message": {
            "text": "Time set to day.",
            "color": "gold"
          }
        },
        {
          "kind": "button",
          "slot": 3,
          "item": "minecraft:black_dye",
          "action_id": "set_night",
          "name": {
            "text": "Set Night",
            "color": "dark_purple"
          },
          "commands": [
            "time set night"
          ],
          "sound": "minecraft:ui.button.click",
          "success_message": {
            "text": "Time set to night.",
            "color": "dark_purple"
          }
        },
        {
          "kind": "counter",
          "slot": 9,
          "item": "minecraft:red_concrete",
          "action_id": "level_dec",
          "score": "guigen_level",
          "delta": -1,
          "min": 0,
          "max": 10,
          "name": {
            "text": "− Level",
            "color": "red"
          },
          "sound": "minecraft:ui.button.click"
        },
        {
          "kind": "label",
          "slot": 10,
          "item": "minecraft:experience_bottle",
          "name": {
            "text": "Level (see actionbar/chat)",
            "color": "aqua"
          },
          "lore": [
            {
              "text": "Adjusted by − / + buttons",
              "color": "gray"
            }
          ]
        },
        {
          "kind": "counter",
          "slot": 11,
          "item": "minecraft:lime_concrete",
          "action_id": "level_inc",
          "score": "guigen_level",
          "delta": 1,
          "min": 0,
          "max": 10,
          "name": {
            "text": "+ Level",
            "color": "green"
          },
          "sound": "minecraft:ui.button.click"
        },
        {
          "kind": "progress",
          "slot": 18,
          "score": "guigen_level",
          "width": 5,
          "max": 10,
          "name": {
            "text": "Level bar",
            "color": "green"
          },
          "full_item": "minecraft:lime_stained_glass_pane",
          "empty_item": "minecraft:gray_stained_glass_pane"
        },
        {
          "kind": "nav",
          "slot": 6,
          "item": "minecraft:arrow",
          "action_id": "page_prev",
          "name": {
            "text": "← Previous",
            "color": "yellow"
          },
          "target_page": 0,
          "sound": "minecraft:ui.button.click",
          "success_message": {
            "text": "Page 0 – Main",
            "color": "yellow"
          }
        },
        {
          "kind": "close",
          "slot": 8,
          "sound": "minecraft:ui.button.click"
        }
      ]
    },
    {
      "index": 2,
      "name": "Confirm",
      "widgets": [
        {
          "kind": "label",
          "slot": 1,
          "item": "minecraft:name_tag",
          "name": {
            "text": "Teleport to 0, 100, 0 ?",
            "color": "gold"
          }
        },
        {
          "kind": "separator",
          "slot": 0
        },
        {
          "kind": "separator",
          "slot": 2
        },
        {
          "kind": "button",
          "slot": 3,
          "item": "minecraft:lime_concrete",
          "action_id": "teleport_spawn",
          "name": {
            "text": "CONFIRM",
            "color": "green"
          },
          "commands": [
            "teleport @s 0 100 0",
            "scoreboard players set @s guigen_page 0"
          ],
          "sound": "minecraft:entity.enderman.teleport",
          "success_message": {
            "text": "Teleported to spawn.",
            "color": "aqua"
          }
        },
        {
          "kind": "nav",
          "slot": 5,
          "item": "minecraft:red_concrete",
          "action_id": "page_main",
          "name": {
            "text": "CANCEL",
            "color": "red"
